  "faqs": [
    {
      "q": "How does same-day delivery work?",
      "a": "Place your order before 2pm on a day we are open and choose today as the delivery date. We deliver in the slot you pick."
    },
    {
      "q": "Can I add a card message?",
      "a": "Yes. Write your message at checkout and we will hand-write it on a card."
    },
    {
      "q": "What if nobody is home?",
      "a": "Our courier will try the number you gave, then leave the flowers with a neighbour or in a safe place and let you know."
    },
    {
      "q": "Can I change or cancel an order?",
      "a": "Contact us as early as you can. We can usually change an order until we start arranging it."
    }
  ],
